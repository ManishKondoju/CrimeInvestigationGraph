# Frontend (Vercel) environment. Copy to .env.local for local dev.
#
# BACKEND_URL and API_KEY are SERVER-SIDE ONLY - they must never be prefixed
# with NEXT_PUBLIC_, or they would be inlined into the browser bundle.

# Origin of the deployed FastAPI service, e.g. https://crimegraphrag-api.onrender.com
BACKEND_URL=http://localhost:8000

# Shared secret; must match the backend's API_KEY env var.
API_KEY=
